  "nodes": {
    "intro": {
      "speaker": "narr",
      "text": "1989 年 4 月 17 日，星期一，晚上。宿舍樓的走廊裡有人在收音機旁小聲說話。兩天前，胡耀邦去世了。",
      "event": "1989-04-15-hu-yaobang-death",
      "choices": [
        {
          "text": "下樓看看",
          "diary": "4/17 晚。樓道裡大家都壓低聲音。"
        }
      ]
    },
    "zhou_1": {
      "speaker": "zhou",
      "text": "你要出去？我姐住東城胡同裡，這封信你要是順路幫我帶一下。不順路就算了，路上別逞強。",
      "choices": [
        {
          "text": "收下信，答應送到",
          "item": "letter",
          "rel": {
            "zhou": 1
          },
          "set": "has_letter",
          "next": "zhou_2"
        },
        {
          "text": "我帶一壺熱水和饅頭去給同學",
          "item": "thermos",
          "set": "has_thermos",
          "next": "zhou_3"
        },
        {
          "text": "我還沒想好",
          "next": "zhou_4"
        }
      ]
    },
    "zhou_2": {
      "speaker": "zhou",
      "text": "信封上寫著地址。她家門口有棵大槐樹，好找。",
      "choices": [
        {
          "text": "好",
          "diary": "幫老周帶信給他姐姐。"
        }
      ]
    },
    "zhou_3": {
      "speaker": "zhou",
      "text": "暖壺是食堂的，記得還回來啊。",
      "choices": [
        {
          "text": "知道",
          "diary": "帶了一壺熱水和兩個饅頭。"
        }
      ]
    },
    "zhou_4": {
      "speaker": "zhou",
      "text": "那你想好了再來找我。",
      "choices": [
        {
          "text": "嗯"
        }
      ]
    },
    "board_1": {
      "speaker": "narr",
      "text": "布告欄上貼滿了新的紙，墨跡還沒全乾。有輓聯，有詩，也有人只寫了幾個大字：「悼念耀邦」。",
      "event": "1989-04-15-hu-yaobang-death",
      "choices": [
        {
          "text": "抄一段在本子上",
          "diary": "布告欄上的字，抄了一段。字很多，我只看懂一半人的心情。",
          "set": "read_board"
        },
        {
          "text": "看看就走",
          "set": "read_board"
        }
      ]
    },
    "lin_1": {
      "speaker": "lin",
      "text": "聽說今天下午就有別的學校的人去了廣場。有人說今晚還會有更多人去，也有人說只是傳言。你信嗎？",
      "event": "1989-04-17-campus-to-square",
      "choices": [
        {
          "text": "我信，晚上我也想去看看",
          "rel": {
            "lin": 1
          },
          "set": "rumor_believed",
          "diary": "小梅說有人去了廣場。我想親眼看看。",
          "next": "lin_2"
        },
        {
          "text": "去問問別人，再決定",
          "set": "rumor_verify",
          "diary": "小梅聽到的消息，我還不知道真假。",
          "next": "lin_3"
        },
        {
          "text": "這種話先別亂傳",
          "rel": {
            "lin": -1
          },
          "next": "lin_4"
        }
      ]
    },
    "lin_2": {
      "speaker": "lin",
      "text": "我得先回去寫作業。你要去的話，回來跟我說說看到了什麼。",
      "choices": [
        {
          "text": "好"
        }
      ]
    },
    "lin_3": {
      "speaker": "lin",
      "text": "也對。誰說的都不一定準。",
      "choices": [
        {
          "text": "嗯"
        }
      ]
    },
    "lin_4": {
      "speaker": "lin",
      "text": "……我也只是聽說。",
      "choices": [
        {
          "text": "嗯"
        }
      ]
    },
    "gate_1": {
      "speaker": "narr",
      "text": "西校門的紅柱子和「北京大學」匾在燈下很亮，門前一對石獅子。門口停著一排二八自行車，有人推車出去，有人剛回來。",
      "choices": [
        {
          "text": "騎車進城",
          "requires": "has_item",
          "goto": "street"
        },
        {
          "text": "再在校園裡轉轉"
        }
      ]
    },
    "sun_1": {
      "speaker": "sun",
      "text": "晚報賣完了。小伙子，大學生吧？今兒晚上往南去的騎車的多。",
      "choices": [
        {
          "text": "大爺，聽說廣場上人很多？",
          "requires": "rumor_relayed",
          "next": "sun_2"
        },
        {
          "text": "買一份明天的？還沒來呢吧",
          "next": "sun_3"
        }
      ]
    },
    "sun_2": {
      "speaker": "sun",
      "text": "我坐這兒哪知道。聽說的多了，自己看見的才算數。",
      "set": "talked_sun",
      "choices": [
        {
          "text": "說得是",
          "diary": "報亭大爺：「自己看見的才算數。」"
        }
      ]
    },
    "sun_3": {
      "speaker": "sun",
      "text": "還早呢。明兒一早來。",
      "choices": [
        {
          "text": "好"
        }
      ]
    },
    "speaker_1": {
      "speaker": "narr",
      "text": "電線杆上的喇叭沙沙響，正在播天氣：明天晴，有風。路過的人沒有停下來聽。",
      "choices": [
        {
          "text": "繼續走"
        }
      ]
    },
    "wang_1": {
      "speaker": "wang",
      "text": "剛下夜班。廠裡也有人在議論。我是不懂你們學生想什麼，就是物價這兩年漲得心裡沒底。",
      "choices": [
        {
          "text": "聽他說下去",
          "rel": {
            "wang": 1
          },
          "next": "wang_2"
        },
        {
          "text": "跟他說校園裡貼的字",
          "requires": "read_board",
          "next": "wang_3"
        }
      ]
    },
    "wang_2": {
      "speaker": "wang",
      "text": "家裡還有孩子。早點回去吧，夜裡涼。",
      "choices": [
        {
          "text": "您也慢點",
          "diary": "遇到一位下夜班的師傅，他擔心的是物價和孩子。"
        }
      ]
    },
    "wang_3": {
      "speaker": "wang",
      "text": "寫字的人是有心的。看的人各有各的想法。",
      "choices": [
        {
          "text": "嗯",
          "diary": "跟一位師傅說了布告欄的事。"
        }
      ]
    },
    "youth_1": {
      "speaker": "youth",
      "text": "我們往廣場去。聽說那邊已經上萬人了——我也是聽說的。你一塊兒走？",
      "event": "1989-04-17-rumor-square-crowd",
      "choices": [
        {
          "text": "相信，跟他們一起往南",
          "set": "follow_crowd",
          "diary": "跟著一群別校的學生往南騎。",
          "goto": "changan"
        },
        {
          "text": "把這話轉述給報亭大爺",
          "set": "rumor_relayed",
          "next": "youth_2"
        },
        {
          "text": "我先去送東西",
          "next": "youth_3"
        }
      ]
    },
    "youth_2": {
      "speaker": "narr",
      "text": "你把話記在心裡。後來你才知道，「上萬」這個數字誰也說不準。",
      "choices": [
        {
          "text": "記下來",
          "diary": "聽說廣場上上萬人。我沒看見，不能確定。"
        }
      ]
    },
    "youth_3": {
      "speaker": "youth",
      "text": "行，那回頭見。",
      "choices": [
        {
          "text": "回頭見"
        }
      ]
    },
    "home_1": {
      "speaker": "narr",
      "text": "胡同口有一棵老槐樹，院門上貼著褪了色的春聯。",
      "choices": [
        {
          "text": "把信交給老周的姐姐",
          "requires": "has_letter",
          "rel": {
            "zhou": 1
          },
          "diary": "信送到了。她留我喝了碗熱水，問學校裡怎麼樣。",
          "end": "letter"
        },
        {
          "text": "把熱水送給在路口等人的同學",
          "requires": "has_thermos",
          "diary": "熱水送到。他們說晚點要往南走。",
          "end": "thermos"
        },
        {
          "text": "騎去長安街看看",
          "diary": "送完東西，還是想去長安街看一眼。",
          "goto": "changan"
        },
        {
          "text": "今晚先回學校",
          "end": "home"
        }
      ]
    },
    "tam_1": {
      "speaker": "narr",
      "text": "長安街很寬，車鈴聲從兩邊的自行車道傳過來。北邊是天安門城樓，燈照著紅牆和黃瓦，城樓下的兩條標語在夜裡也看得清。南邊就是廣場。",
      "event": "1989-04-17-campus-to-square",
      "choices": [
        {
          "text": "停下來看一會兒",
          "diary": "第一次在夜裡騎到天安門前。城樓比想像中大。"
        },
        {
          "text": "繼續騎"
        }
      ]
    },
    "repair_1": {
      "speaker": "repairer",
      "text": "打氣兩分，補胎五毛。今兒晚上過去的學生不少，我這兒也忙。",
      "choices": [
        {
          "text": "大爺，廣場上真有上萬人？",
          "requires": "rumor_relayed",
          "next": "repair_2"
        },
        {
          "text": "給車打個氣",
          "diary": "在長安街邊打了氣，花了兩分錢。",
          "next": "repair_3"
        }
      ]
    },
    "repair_2": {
      "speaker": "repairer",
      "text": "上萬？我沒數。你自己往那邊瞧瞧不就知道了。",
      "choices": [
        {
          "text": "轉身看廣場",
          "diary": "修車的大爺也說不準有多少人。自己看，比聽說的少，也比想像的安靜。"
        }
      ]
    },
    "repair_3": {
      "speaker": "repairer",
      "text": "好了。夜裡騎慢點。",
      "choices": [
        {
          "text": "謝謝您"
        }
      ]
    },
    "square_1": {
      "speaker": "stu2",
      "text": "我們學校的人在那邊。我也不知道要待到幾點，就是覺得應該來。",
      "choices": [
        {
          "text": "在她旁邊坐一會兒",
          "rel": {
            "stu2": 1
          },
          "diary": "在廣場北邊坐了一會兒。旁邊的人小聲說話，沒人知道明天會怎樣。",
          "end": "south"
        },
        {
          "text": "把熱水分給她們",
          "requires": "has_thermos",
          "diary": "熱水在廣場邊分完了。",
          "end": "thermos"
        },
        {
          "text": "點點頭，往回走"
        }
      ]
    },
    "turn_1": {
      "speaker": "narr",
      "text": "再往東就是王府井了。夜深了，回學校還要騎很久。",
      "choices": [
        {
          "text": "往廣場那邊走",
          "next": "turn_2"
        },
        {
          "text": "回學校",
          "end": "home"
        }
      ]
    },
    "turn_2": {
      "speaker": "narr",
      "text": "你推著車，走到廣場北邊的邊上。",
      "choices": [
        {
          "text": "好",
          "end": "south"
        }
      ]
    }
  },
  "endings": {
    "south": {
      "title": "往南",
      "text": "你在廣場北邊站了很久。夜風很涼，人群很安靜。你還不知道接下來的幾個星期會發生什麼。"
    },
    "letter": {
      "title": "一封信",
      "text": "信送到了。回學校的路上，街上的人比來時多。你決定明天再來城裡看看。"
    },
    "thermos": {
      "title": "一壺熱水",
      "text": "暖壺空了。你騎車回學校，想著那些往南走的人今晚會在哪裡過夜。"
    },
    "home": {
      "title": "回宿舍",
      "text": "你回到宿舍。老周還沒睡，問你外面怎麼樣。你想了一下，說：「說不清。」"
    }
  },
  "epilogue": "第一章完。歷史的走向已經確定；你帶著的是自己的見聞。下一章：四月二十二日。"
}